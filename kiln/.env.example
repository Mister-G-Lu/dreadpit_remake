PORT=3000
HOST=0.0.0.0
# Google AI Studio key. Free Flash tier is enough for 128 matches/day.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# DreadPit fires at 12:00 GMT. Uncomment for the same "noon judgment" feel.
# FIRE_UTC_HOUR=12
# Set 0 when a real cron (npm run round / node server/job.js) is the trigger,
# so the in-process 15s poller stays off. Leave unset for a self-scheduling
# single server.
KILN_POLL=1
# DreadPit fires the whole bracket at the mark and throttles by retrying.
# Raise BATCH_SIZE to the full round and lower the interval to get that feel;
# the default below is the gentler 10-matches/hour stutter.
BATCH_SIZE=10
BATCH_INTERVAL_MS=3600000
# Max living vessels on the stack, and max new vessels admitted per UTC day.
MAX_ROSTER=256
# Images a logged-in user may fire per UTC day.
SPARKS_PER_DAY=10
