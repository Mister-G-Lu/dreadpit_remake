PORT=3000
HOST=0.0.0.0
# Google AI Studio key. Free Flash tier is enough for 128 matches/day in 10-match hourly batches.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional Pollinations app key (pk_...) so BYOP consent shows your app name.
VITE_POLLINATIONS_APP_KEY=
# 10 matches per hour. First batch fires immediately when a round opens.
BATCH_SIZE=10
BATCH_INTERVAL_MS=3600000
# Max living vessels on the stack, and max new vessels admitted per UTC day.
MAX_ROSTER=256
# Images a logged-in user may fire per UTC day.
SPARKS_PER_DAY=10
