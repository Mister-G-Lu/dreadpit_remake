# Kiln production environment (loaded by systemd via EnvironmentFile=/etc/kiln.env)
NODE_ENV=production

# API listener
PORT=3000
HOST=0.0.0.0

# Google AI Studio key. Without it the "lesser eye" still closes matches.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DreadPit parity: fires at 12:00 UTC instead of the default 00:00 UTC.
# FIRE_UTC_HOUR=12

# Trigger mode: 1 = in-process 15s poller (default, single long-lived server).
# Set 0 ONLY if you enable kiln-round.timer as the sole trigger — never both.
KILN_POLL=1

# Round pacing. Defaults are the gentle 10-matches/hour stutter. For a
# DreadPit-style "fire the whole bracket at the mark" set BATCH_SIZE=64 and
# BATCH_INTERVAL_MS=15000.
BATCH_SIZE=10
BATCH_INTERVAL_MS=3600000

# Roster/caps
MAX_ROSTER=256
SPARKS_PER_DAY=10
USER_SLOTS=15

# Bot pool
KILN_BOTS=1
BOT_COOLDOWN_DAYS=1

# Optional: set to a real domain for the HTTPS Caddy block.
# DOMAIN=pit.example.com
